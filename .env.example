# UpaSārathi: every key is OPTIONAL. With no keys, the reader, graph, paths and all recorded
# harness runs work. Keys only enable LIVE harness runs.
#
# On a public deployment visitors bring their own key (Settings → Language model). Keys in the
# server's environment serve ONLY requests from this machine (localhost), so visitors never spend yours.

# Used by `npm run runs:record` and by local live runs.
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Optional local model server (local requests only).
OLLAMA_BASE_URL=http://localhost:11434
