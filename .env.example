# UpaSārathi: every key is OPTIONAL. With no keys, the cosmos, the reader, the paths, graph-only answers and all
# recorded harness runs work. Keys enable written answers in Ask and live harness runs.
#
# On a public deployment visitors bring their own key (Connect a model). Keys in the server's environment serve
# ONLY requests from this machine (localhost), so visitors never spend yours.
# The downloadable harness (public/downloads/upasarathi-harness.mjs) reads the same variables.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=          # also used by `npm run runs:record`
OPENROUTER_API_KEY=
OPENAI_COMPAT_API_KEY= # any OpenAI-compatible endpoint (give its base URL in settings or --base-url)

# Optional local model server (local requests only).
OLLAMA_BASE_URL=http://localhost:11434
